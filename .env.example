# Copy to .env (git-ignored) and fill in locally. Never commit .env or paste keys into chat.

# Gemini API key from Google AI Studio. Server-side only: it is never sent to the browser.
GEMINI_API_KEY=

# Models (override if your account lacks access; run `npm run check:models` to verify).
LIVE_MODEL=gemini-3.8-live
VISION_MODEL=gemini-3.6-flash
# Prebuilt voice for Live audio output.
LIVE_VOICE=Kore

# HTTP server. 127.0.0.1 is enough for USB (adb reverse) access from the phone.
PORT=3000
HOST=127.0.0.1

# Access gate. REQUIRED for any non-localhost Host (tunnel/HTTPS deployment).
# Open https://<host>/?access=<token> once on the phone; an HttpOnly cookie is set.
ACCESS_TOKEN=
# Extra allowed WebSocket origins, comma-separated (same-origin is always allowed).
ALLOWED_ORIGINS=

# Limits
MAX_SESSION_MINUTES=20
MAX_CONCURRENT_SESSIONS=2

# Timezone used for date comparisons on packaging.
APP_TIMEZONE=Europe/London

# Optional local YOLO detector service (see services/detector/README.md). Empty = disabled.
DETECTOR_URL=
