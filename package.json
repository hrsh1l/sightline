{
  "name": "sightline",
  "version": "0.1.0",
  "private": true,
  "description": "Sightline: ask about what's in front of you. Conversational visual assistant prototype (phone web app + Node backend).",
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/server/index.ts",
    "build": "vite build && tsc -p tsconfig.server.json && node scripts/check-client-secrets.mjs",
    "start": "NODE_ENV=production node dist/server/server/index.js",
    "typecheck": "tsc -p tsconfig.client.json && tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.test.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check:secrets": "node scripts/check-client-secrets.mjs",
    "check:models": "tsx scripts/check-models.ts",
    "verify": "npm run typecheck && npm run lint && npm run build && npm test && npm run check:secrets",
    "detector": "cd services/detector && uv run python server.py --port 8765",
    "test:e2e:find": "playwright test -c playwright.find.config.ts"
  },
  "dependencies": {
    "@google/genai": "3.6.1",
    "dotenv": "18.0.10",
    "express": "5.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5",
    "ws": "8.23.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@testing-library/react": "16.3.3",
    "@types/express": "5.0.6",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "10.15.0",
    "globals": "17.14.0",
    "jsdom": "31.0.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.74.0",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
